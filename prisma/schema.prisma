generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESEARCHER
}

enum AnnotationAnswer {
  UNCONVENTIONAL
  CONVENTIONAL
  NOT_SURE
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  role          Role         @default(RESEARCHER)
  accounts      Account[]
  sessions      Session[]
  annotations   Annotation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Frame {
  id          String       @id @default(cuid())
  movie       String
  frameImage  String
  timecode    String
  director    String
  dop         String
  sequence    Int
  notes       String?
  annotations Annotation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([movie])
  @@index([sequence])
}

model Annotation {
  id        String           @id @default(cuid())
  userId    String
  frameId   String
  answer    AnnotationAnswer
  notes     String?
  timestamp DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  frame     Frame            @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@unique([userId, frameId])
  @@index([answer])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
