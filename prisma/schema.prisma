generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESEARCHER
}

enum AnnotationAnswer {
  UNCONVENTIONAL
  CONVENTIONAL
  NOT_SURE
}

// Admin / researcher accounts (NextAuth). Study participants live in `Participant`.
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(RESEARCHER)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// A person taking the study: captured on the intro screen (name + profession).
model Participant {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  profession  String
  avatar      String? // small data-URL thumbnail (resized in the browser)
  annotations Annotation[]
  createdAt   DateTime     @default(now())

  @@index([profession])
}

model Frame {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  movie       String
  frameImage  String
  timecode    String
  director    String
  dop         String
  sequence    Int          @unique
  notes       String?
  annotations Annotation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([movie])
}

model Annotation {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  participantId String           @db.ObjectId
  frameId       String           @db.ObjectId
  rating        Int? // 1-5 on the admin-defined scale
  answer        AnnotationAnswer? // legacy three-way answer, no longer written
  notes         String?
  timestamp     DateTime         @default(now())
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  frame         Frame            @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@unique([participantId, frameId])
  @@index([rating])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Small key/value store for admin-editable settings (for example the rating scale labels).
model Setting {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value Json
}
